{
  "name": "weldvision-x5",
  "productName": "WeldVision X5",
  "version": "1.0.0",
  "description": "AI-Powered Weld Defect Detection and Model Training Platform",
  "author": "WeldVision Team",
  "private": true,
  "main": "electron-main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "backend": "cd desktop_server && \".venv/Scripts/python\" manage.py runserver 0.0.0.0:8000",
    "start": "concurrently \"npm run backend\" \"npm run dev\" --names \"DJANGO,REACT\" --prefix-colors \"yellow,cyan\"",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.555.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^3.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}